restaurant_system/
│
├── main.py                     # The "Start Button" (Only initializes the app)
├── database/                   # Everything SQL & DB related
│   ├── __init__.py
│   ├── connection.py           # Engine & SessionLocal setup
│   └── models.py               # SQLAlchemy Database Models
│
├── api/                        # Router modules split by domain
│   ├── __init__.py
│   ├── schemas.py              # Pydantic schemas (Request/Response validation)
│   ├── reservations.py         # Guest & Admin Reservation endpoints
│   └── tables.py               # Physical Layout Management endpoints
│   └── reservations.py         # ONLY handles HTTP requests, validation, and responses   
│
└── services/                   # The "Brain" of your application
|    ├── __init__.py
|    └── reservation_service.py # Core algorithms, table-matching logic, time-slot sorting
|
├── errors/                     # Custom exceptions and global handlers
│   ├── __init__.py
│   └── handlers.py
│
├── tests/                      # Regressive automated testing suite
│   ├── __init__.py
│   └── test_reservations.py
│
└── templates/                  # Frontend HTML/CSS layouts (If serving pages)
    └── index.html




